# Copy to ~/.planbridge/.env (or a .env in the folder you run planbridge from).

# Where the server listens. Keep 127.0.0.1: personal use only.
PLANBRIDGE_HOST=127.0.0.1
PLANBRIDGE_PORT=3456

# Your local key. Empty = generated once and saved to ~/.planbridge/api-key.txt
PLANBRIDGE_API_KEY=

# Defaults when a request does not say
DEFAULT_MODEL=sonnet            # sonnet | opus | haiku | fable | claude-…
DEFAULT_EFFORT=                 # low | medium | high | xhigh | max
DEFAULT_SYSTEM_PROMPT=

# Guard rails (protect your plan limits)
MAX_CONCURRENT=2
MAX_QUEUE=20
RATE_LIMIT_PER_MIN=30
REQUEST_TIMEOUT_MS=300000
MAX_BODY_MB=25

# Warm pool: keeps Claude Code processes pre-started so the first token arrives ~35% sooner.
# Each idle process uses ~240 MB RAM. 0 disables.
WARM_POOL=2
WARM_TTL_MS=300000

# Allowed browser origins for local web pages ("" disables CORS)
CORS_ORIGIN=*

# Path to Claude Code if it is not on PATH
CLAUDE_BIN=claude
